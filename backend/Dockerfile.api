FROM public.ecr.aws/lambda/python:3.11

COPY requirements-runtime.txt requirements-api.txt ${LAMBDA_TASK_ROOT}/
RUN pip install \
    --disable-pip-version-check \
    --no-cache-dir \
    -r ${LAMBDA_TASK_ROOT}/requirements-api.txt

COPY app ${LAMBDA_TASK_ROOT}/app
COPY lambdas/__init__.py lambdas/common.py lambdas/schedule.py lambdas/notify.py lambdas/public_discussion_schedule.py ${LAMBDA_TASK_ROOT}/lambdas/
# The category sentiment view looks up each stored category's sentiment
# bucket in the taxonomy, and the topic routes read the content topic
# taxonomy. These packages use only the standard library.
COPY parsing/__init__.py ${LAMBDA_TASK_ROOT}/parsing/
COPY parsing/categories ${LAMBDA_TASK_ROOT}/parsing/categories
COPY parsing/classification ${LAMBDA_TASK_ROOT}/parsing/classification
COPY parsing/content_topics ${LAMBDA_TASK_ROOT}/parsing/content_topics
COPY main.py lambda_api.py viewer.html ${LAMBDA_TASK_ROOT}/

CMD ["lambda_api.handler"]
