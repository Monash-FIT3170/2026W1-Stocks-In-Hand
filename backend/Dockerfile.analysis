FROM public.ecr.aws/lambda/python:3.12

ARG FINBERT_REVISION=4556d13015211d73dccd3fdd39d39232506f3e43

COPY requirements-runtime.txt requirements-analysis.txt ${LAMBDA_TASK_ROOT}/
RUN pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cpu \
    torch==2.13.0
RUN pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements-analysis.txt
# RapidOCR declares desktop OpenCV, which expects X11 libraries absent from
# Lambda. Replace it with the API-compatible headless wheel.
RUN pip uninstall -y opencv-python \
    && pip install --no-cache-dir --no-deps \
        opencv-python-headless==5.0.0.93

# Resolve the model during the image build, at an immutable revision. Lambda
# execution never needs Hugging Face network access.
RUN python -c "from transformers import AutoModelForSequenceClassification, AutoTokenizer; revision='${FINBERT_REVISION}'; tokenizer=AutoTokenizer.from_pretrained('ProsusAI/finbert', revision=revision); model=AutoModelForSequenceClassification.from_pretrained('ProsusAI/finbert', revision=revision); tokenizer.save_pretrained('/var/task/models/finbert'); model.save_pretrained('/var/task/models/finbert')" \
    && chmod -R a+rX /var/task/models/finbert \
    && test "$(stat -c '%a' /var/task/models/finbert/model.safetensors)" = "644" \
    && rm -rf /root/.cache/huggingface
# Fail the image build if the exact offline runtime path cannot tokenize and
# execute the packaged model without Hugging Face network access.
RUN HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 python -c "import torch; from transformers import AutoModelForSequenceClassification, AutoTokenizer; tokenizer=AutoTokenizer.from_pretrained('/var/task/models/finbert', local_files_only=True); model=AutoModelForSequenceClassification.from_pretrained('/var/task/models/finbert', local_files_only=True); encoded=tokenizer(['FinBERT image smoke test'], return_tensors='pt'); logits=model(**encoded).logits; assert logits.shape[-1] == 3"

COPY app ${LAMBDA_TASK_ROOT}/app
COPY lambdas ${LAMBDA_TASK_ROOT}/lambdas

# Only the modules the analysis handler actually imports. parsing/env.py and
# parsing/print_artifacts.py are local CLI-only tools and are deliberately not
# shipped into the Lambda image.
COPY parsing/__init__.py parsing/analysis.py parsing/classifier.py \
    ${LAMBDA_TASK_ROOT}/parsing/
COPY parsing/categories ${LAMBDA_TASK_ROOT}/parsing/categories

# RapidOCR includes its ONNX models in the image, so scanned PDFs are analysed
# without Textract, network calls, or a separate OCR service.
ENV FINBERT_MODEL=/var/task/models/finbert \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    TOKENIZERS_PARALLELISM=false

CMD ["lambdas.analysis.handler"]
