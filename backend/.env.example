FINBERT_MODEL="/app/finbert"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=windows:stocks-in-hand:1.0.0 (by /u/your_reddit_username)
# In AWS these name the SSM parameters that hold the values above. Leave them
# empty locally.
REDDIT_CLIENT_ID_PARAMETER=
REDDIT_CLIENT_SECRET_PARAMETER=
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE_URL=https://bsky.social
BLUESKY_PUBLIC_API_URL=https://public.api.bsky.app
# Comma-separated HTTPS RSS or Atom URLs. Only listed feeds can be fetched.
PUBLIC_DISCUSSION_FEED_URLS=
PUBLIC_DISCUSSION_FEED_URLS_PARAMETER=
ANALYSIS_QUEUE_URL=
# Amazon Bedrock is the active LLM provider. AWS credentials come from the
# standard AWS credential chain locally and the Lambda execution role in AWS.
LLM_PROVIDER="bedrock"
BEDROCK_ENABLED="false"
BEDROCK_MODEL_ID="openai.gpt-oss-120b-1:0"
BEDROCK_SERVICE_TIER="default"
BEDROCK_MAX_PROMPT_CHARS="30000"
# Optional local rollback provider. Staging does not load this key.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
MARKETAUX_API_TOKEN=""
MARKETAUX_BASE_URL="https://api.marketaux.com/v1"
NEWS_FETCH_LIMIT=10
AWS_REGION="ap-southeast-2"
# legacy, dual during a coordinated switch, or cognito
AUTH_PROVIDER="legacy"
COGNITO_USER_POOL_ID=""
COGNITO_APP_CLIENT_ID=""
COGNITO_ISSUER=""
COGNITO_JWKS_CACHE_SECONDS="300"
COGNITO_LINK_EXISTING_BY_EMAIL="false"
NOTIFICATIONS_ENABLED="false"
NOTIFICATIONS_DRY_RUN="true"
NOTIFICATION_QUEUE_URL=""
ALERT_SENDER_EMAIL=""
ALERT_SENDER_NAME="Stocks In Hand"
BREVO_API_KEY=""
BREVO_API_KEY_PARAMETER=""
BREVO_API_BASE_URL="https://api.brevo.com/v3"
ALERT_DAILY_BUDGET="180"
ALERT_MAX_PER_INVESTOR_PER_RUN="5"
ALERT_DEFAULT_MIN_CONFIDENCE="0.75"
ALERT_CLAIM_STALE_MINUTES="15"
ALERT_VERIFICATION_TOKEN_TTL_HOURS="24"
FRONTEND_BASE_URL="http://localhost:3000"
# Tickers come from the ticker catalogue in app/sources.py. Manual scraping
# defaults to every catalogue ticker and the schedule to its scheduled ones;
# uncomment to narrow either to a comma-separated subset.
# SUPPORTED_TICKERS="CSL,WES"
# SCHEDULED_TICKERS="CSL"
DISCOVERY_LOOKBACK_DAYS="30"
MAX_DOCUMENTS_PER_RUN="3"
MAX_DOCUMENT_BYTES="26214400"
MAX_PDF_PAGES="500"
MAX_OCR_PAGES="5"
MAX_ANALYSIS_CHARS="50000"
# Content topic tagging. The LLM is asked only while an LLM is switched on;
# otherwise keyword rules tag each analysed artifact.
CONTENT_TOPICS_LLM_ENABLED="true"
CONTENT_TOPIC_MIN_CONFIDENCE="0.5"
CONTENT_TOPIC_CLUSTER_WINDOW_DAYS="14"

# --- Optional: only needed if you're running the discovery -> download -> analysis
# pipeline locally (see "Local pipeline development" in the README). Leave DISCOVERY_QUEUE_URL
# empty to keep POST /scrape/{ticker} disabled, which is the default local behaviour. ---
DISCOVERY_QUEUE_URL=""
DOWNLOAD_QUEUE_URL=""
RAW_DOCUMENT_BUCKET=""
MAX_DOCX_UNCOMPRESSED_BYTES="20971520"
MAX_OCR_PIXELS_PER_PAGE="8000000"

# --- Optional: database connection. Docker Compose sets DATABASE_URL directly on the
# service, so this is only needed if you run the backend outside Docker. ---
DATABASE_URL="postgresql://user:password@localhost:5432/spike"

# --- Optional: web/session settings. Defaults below match app/core/config.py's fallbacks. ---
CORS_ORIGINS="http://localhost:3000"
SESSION_COOKIE_NAME="stonks_session"
SESSION_EXPIRE_DAYS="7"
SESSION_COOKIE_SECURE="false"
SESSION_COOKIE_SAMESITE="lax"

# --- AWS only: SSM parameter *names* (not secret values). When a setting is not
# set but its *_PARAMETER is, app/core/config.py reads the value from SSM the
# first time any setting is used. Leave them empty outside an AWS deployment. ---
DATABASE_URL_PARAMETER=""
