# --- Required for local docker-compose use ---
GEMINI_MODEL="gemini-2.5-flash"
FINBERT_MODEL="/app/finbert"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GEMINI_API_KEY=""
MARKETAUX_API_TOKEN=""
MARKETAUX_BASE_URL="https://api.marketaux.com/v1"
NEWS_FETCH_LIMIT=10
AWS_REGION="ap-southeast-2"
SUPPORTED_TICKERS="ANZ,BHP,CBA,CSL,WES"
SCHEDULED_TICKERS="ANZ,BHP,CBA,CSL,WES"
DISCOVERY_LOOKBACK_DAYS="30"
MAX_DOCUMENTS_PER_RUN="3"
MAX_DOCUMENT_BYTES="10485760"
MAX_PDF_PAGES="100"
MAX_OCR_PAGES="5"
MAX_ANALYSIS_CHARS="50000"
ANZ_SOURCE_URL="https://www.anz.com/shareholder/centre/investor-toolkit/asx-announcements/"
BHP_SOURCE_URL="https://www.bhp.com/investor-hub/market-announcements"
CBA_SOURCE_URL="https://www.commbank.com.au/about-us/investors/asx-announcements.html"
CSL_SOURCE_URL="https://investors.csl.com/investors/asx-announcements"
WES_SOURCE_URL="https://www.wesfarmers.com.au/investor-centre/company-performance-news/asx-announcements"

# --- Optional: only needed if you're running the discovery -> download -> analysis
# pipeline locally (see "Local pipeline development" in the README). Leave DISCOVERY_QUEUE_URL
# empty to keep POST /scrape/{ticker} disabled, which is the default local behaviour. ---
DISCOVERY_QUEUE_URL=""
DOWNLOAD_QUEUE_URL=""
RAW_DOCUMENT_BUCKET=""
MAX_DOCX_UNCOMPRESSED_BYTES="20971520"
MAX_OCR_PIXELS_PER_PAGE="8000000"

# --- Optional: database connection. Docker Compose sets DATABASE_URL directly on the
# service, so this is only needed if you run the backend outside Docker. ---
DATABASE_URL="postgresql://user:password@localhost:5432/spike"

# --- Optional: web/session settings. Defaults below match app/core/config.py's fallbacks. ---
CORS_ORIGINS="http://localhost:3000"
SESSION_COOKIE_NAME="stonks_session"
SESSION_EXPIRE_DAYS="7"
SESSION_COOKIE_SECURE="false"
SESSION_COOKIE_SAMESITE="lax"

# --- Lambda-only: these are SSM parameter *names* (not secret values) that
# lambdas/common.py resolves at cold start via boto3. They are not used locally
# and should be left unset outside an actual AWS deployment. ---
DATABASE_URL_PARAMETER=""
GROQ_API_KEY_PARAMETER=""
